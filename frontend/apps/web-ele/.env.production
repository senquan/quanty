VITE_BASE=/

# 接口地址：同源路径，由部署环境的 nginx 反代 /api → backend（免 CORS、免硬编码域名）
# ⚠️ 原值为 vben 官方 mock（https://mock-napi.vben.pro/api），生产构建会打到假接口。
VITE_GLOB_API_URL=/api/v1

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
