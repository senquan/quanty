# Database Configuration
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/quant_db

# JWT Configuration
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- 内部令牌（**权威字段**）----
# 用于：① dc 拨入 /ws/dc 的握手校验（app/ws/server.py）
#       ② dc 调用 backend 内部端点（/trading/orders/internal）的 X-Internal-Token
# 必须与 data-cleaner/.env 的 STRATEGY_INTERNAL_TOKEN **完全一致**；
# 仅存于 .env（已被 gitignore，切勿提交真实值）。轮换：两端同时改值即生效。
STRATEGY_INTERNAL_TOKEN=
# 【遗留】早期文档误称此字段为 WS 握手令牌，代码并不读取它。
# 留空即可；但**不要删除**——旧 .env 若含该键而 Settings 未声明会导致导入失败。
STRAT_INTEGRATION_TOKEN=