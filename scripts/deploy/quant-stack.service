# QuanT 全栈（backend + data-cleaner + frontend，docker compose）systemd 单元
#
# 安装（把 /opt/lab.Quant 换成仓库在服务器上的**绝对路径**）：
#   sudo cp scripts/deploy/quant-stack.service /etc/systemd/system/
#   sudo sed -i 's#/opt/lab.Quant#/your/repo/path#' /etc/systemd/system/quant-stack.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now quant-stack
#
# 常用命令：
#   systemctl status quant-stack
#   systemctl restart quant-stack
#   journalctl -u quant-stack -f
#   docker compose logs -f data-cleaner        # 容器日志（已配 10×50MiB 轮转）
#
# 说明：
# - Type=oneshot + RemainAfterExit：`docker compose up -d` 会立即返回，oneshot 让 systemd
#   在返回后仍把服务视为 active，并能正确执行 ExecStop（停机时优雅 compose down）。
# - 不要在这里加 Restart=：compose 内部容器自带重启策略；而 oneshot 单元重启意义不同。
# - 日志：容器日志由 docker 的 json-file 驱动落盘并轮转（见 docker-compose.yml 的 x-logging）。

[Unit]
Description=QuanT stack (backend + data-cleaner + frontend via docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/lab.Quant
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=900
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
