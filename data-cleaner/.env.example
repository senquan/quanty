# Database (PostgreSQL, 使用独立 schema: factor)
# 本机开发：可复用后端库并落 factor schema；
# docker 部署：指向独立的 factor_db（见根 docker-compose.yml 的 postgres-factor）。
DATABASE_URL=postgresql+asyncpg://quant_user:quant_password@localhost:5432/quant_db

# Redis（心跳 factor:heartbeat / 回填进度 raw_backfill_progress，可重建）
REDIS_URL=redis://localhost:6379/0

# Factor parquet data directory
FACTOR_DATA_DIR=./data/factors

# 失败输入快照目录（便于排查）
QUARANTINE_DIR=./data/quarantine

# ---- 数据源 ----
TUSHARE_TOKEN=
FUNDAMENTAL_PROVIDER=auto          # auto / tushare / akshare
ALPHAFEED_KEY=                      # A股/美股/港股 K线（REST, X-API-Key）
ALPHAFEED_BASE_URL=https://api.alphafeed.org
PANDADATA_USERNAME=                 # A股日线主力源（SDK init_token 鉴权）
PANDADATA_PASSWORD=
PANDADATA_BASE_URL=

# LLM（AI 因子生成，可选；未配置走规则引擎）
LLM_API_KEY=

# Application
DEBUG=True                          # 生产必须 False（为 True 时 uvicorn 热重载）
HOST=0.0.0.0
PORT=8100
TZ=Asia/Shanghai

# ---- 入站鉴权（backend → dc，请求头 X-API-Key）----
# 留空表示关闭认证（开发期友好）；生产务必配置，多个 key 用逗号分隔。
SERVICE_NAME=cleaner-dev
API_KEYS=

# ---- 出站到 backend ----
BACKEND_BASE_URL=http://localhost:8000
# 内部令牌：**必须与 backend 的 STRATEGY_INTERNAL_TOKEN 完全一致**。
# 注意：历史文档写的 `WS_TOKEN` 在 code 中并不存在（死配置），真实字段是下面这个。
STRATEGY_INTERNAL_TOKEN=

# ---- WebSocket 长连接（dc 作为客户端主动连入 backend，1 对多）----
# 总开关：关闭时行为与改造前一致（纯 HTTP），便于一键回退
WS_ENABLED=false
# backend 的 WS 地址（ws:// / wss://）；留空则由 BACKEND_BASE_URL 推导（http→ws + /ws/dc）
BACKEND_WS_URL=
# 本实例身份：backend 连接注册表的键，多实例部署时必须唯一
WS_INSTANCE_ID=
# 必须等于 backend cleaner_services.service_code（副本归属 / 命令通道寻址）
WS_SERVICE_CODE=

# ---- 市场情报模块（可选子模块，不用则保持 false）----
INTEL_ENABLED=false
