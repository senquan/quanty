# Database (PostgreSQL, 复用主后端数据库, 使用独立 schema: factor)
DATABASE_URL=postgresql+asyncpg://quant_user:quant_password@localhost:5432/quant_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Factor parquet data directory
FACTOR_DATA_DIR=./data/factors

# 失败输入快照目录（便于排查）
QUARANTINE_DIR=./data/quarantine

# 财务数据源（价值/成长因子）
TUSHARE_TOKEN=
FUNDAMENTAL_PROVIDER=tushare   # tushare / akshare

# LLM（AI 因子生成，可选；未配置走规则引擎）
LLM_API_KEY=

# Application
DEBUG=True
HOST=0.0.0.0
PORT=8100
TZ=Asia/Shanghai
